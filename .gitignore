# ============================================================
# Dependencies
# Installed via npm in both client/ and server/ - always regenerated
# from package.json + package-lock.json, never hand-edited.
# ============================================================
**/node_modules/

# ============================================================
# Environment variables & secrets
# Real .env files hold real credentials/config for this machine and
# must never be committed. server/.env.example is intentionally NOT
# matched by these rules, so it stays tracked as documentation.
# ============================================================
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# ============================================================
# Corporate certificate
# Machine/company-specific TLS cert (Cisco Umbrella) used only to work
# around corporate proxy SSL inspection on this laptop. Irrelevant to
# other machines, teammates, or CI.
# ============================================================
cert/

# ============================================================
# Build output & generated code
# Everything below is produced automatically by a build/generate step
# (never hand-edited), so it's cheaper to regenerate than to version.
# ============================================================
server/dist/                      # tsc output (npm run build)
client/.next/                     # Next.js build output
client/out/                       # Next.js static export output
*.tsbuildinfo                     # TypeScript incremental build cache

# Prisma generated client + query engine (regenerate with `npx prisma generate`)
server/src/generated/prisma

# ============================================================
# Logs
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================
# OS / editor junk
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# Testing / coverage
# ============================================================
coverage/
*.lcov
.nyc_output

# ============================================================
# Misc caches
# ============================================================
.eslintcache
.npm
